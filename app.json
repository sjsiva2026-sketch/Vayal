{
  "expo": {
    "name": "Namma Vayal",
    "slug": "namma-vayal",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#1C7C54",
    "splash": {
      "backgroundColor": "#1C7C54",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nammavayal.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C7C54"
      },
      "package": "com.nammavayal.app",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "nammavayal" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": { "bundler": "metro" },
    "scheme": "nammavayal",
    "plugins": []
  }
}
