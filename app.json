{
  "expo": {
    "name": "Namma Vayal",
    "slug": "namma-vayal",
    "version": "1.0.9",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#1C7C54",
    "splash": {
      "backgroundColor": "#1C7C54",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vayal.app"
    },
    "android": {
      "package": "com.vayal.app",
      "versionCode": 11,
      "targetSdkVersion": 35,
      "compileSdkVersion": 35,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1C7C54"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "nammavayal" }],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [
            { "mimeType": "image/jpeg" },
            { "mimeType": "image/png" },
            { "mimeType": "image/*" }
          ]
        }
      ]
    },
    "scheme": "nammavayal",
    "plugins": [
      "expo-font",
      "expo-media-library",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/logo.png",
          "color": "#1C7C54",
          "sounds": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Namma Vayal needs photo access to upload KYC and payment screenshots.",
          "cameraPermission": "Namma Vayal needs camera access to capture documents."
        }
      ]
    ],
    "owner": "gunasekar22it241",
    "extra": {
      "eas": {
        "projectId": "6b073f71-f2fe-4f59-ab5c-44984f7643e8"
      }
    }
  }
}
