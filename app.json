{
  "expo": {
    "name": "Namma Vayal",
    "slug": "namma-vayal",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#1C7C54",
    "splash": {
      "backgroundColor": "#1C7C54",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vayal.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Namma Vayal needs camera access to capture KYC documents and payment screenshots.",
        "NSPhotoLibraryUsageDescription": "Namma Vayal needs photo library access to upload KYC documents and payment screenshots.",
        "NSPhotoLibraryAddUsageDescription": "Namma Vayal needs permission to save photos."
      }
    },
    "android": {
      "package": "com.vayal.app",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1C7C54"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "nammavayal"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "nammavayal",
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Namma Vayal needs photo access to upload KYC documents and payment screenshots.",
          "cameraPermission": "Namma Vayal needs camera access to capture documents."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "32ddd1ac-6b7e-4195-a300-4a89c49efe57"
      }
    },
    "owner": "guna22it241"
  }
}
