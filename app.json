{
  "expo": {
    "name": "Namma Vayal",
    "slug": "namma-vayal",
    "version": "1.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#1C7C54",

    "splash": {
      "image": "./assets/icons/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#1C7C54"
    },

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vayal.app"
    },

    "android": {
      "package": "com.vayal.app",
      "versionCode": 15,
      "googleServicesFile": "./google-services.json",

      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/logo.jpg",
        "backgroundColor": "#1C7C54"
      },

      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ],

      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "nammavayal"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/jpeg"
            },
            {
              "mimeType": "image/png"
            },
            {
              "mimeType": "image/*"
            }
          ]
        }
      ]
    },

    "scheme": "nammavayal",

    "notification": {
      "icon": "./assets/icons/logo.jpg",
      "color": "#1C7C54",
      "androidMode": "default",
      "androidCollapsedTitle": "Namma Vayal"
    },

    "plugins": [
      "expo-font",
      "expo-media-library",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/logo.jpg",
          "color": "#1C7C54",
          "defaultChannel": "vayal-default",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Namma Vayal needs photo access to upload KYC and payment screenshots.",
          "cameraPermission": "Namma Vayal needs camera access to capture documents."
        }
      ]
    ],

    "owner": "gunasekar22it241",

    "extra": {
      "eas": {
        "projectId": "6b073f71-f2fe-4f59-ab5c-44984f7643e8"
      }
    }
  }
}
