rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        'PASTE_ADMIN_UID_HERE'
      ];
    }
    function isSignedIn()  { return request.auth != null; }
    function isSelf(uid)   { return request.auth != null && request.auth.uid == uid; }

    function touchesAdminFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'paymentStatus','isLocked','kycStatus',
        'isVerified','accessGranted','adminVerified'
      ]);
    }

    match /users/{uid} {
      allow read:   if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && isSignedIn();
      allow update: if isAdmin() || (isSelf(uid) && !touchesAdminFields());
      allow delete: if isAdmin();
    }

    match /bookings/{id} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.farmerId == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn()
          && (resource.data.ownerId  == request.auth.uid
           || resource.data.farmerId == request.auth.uid)
          && !touchesAdminFields());
      allow delete: if isAdmin()
        || (isSignedIn()
          && (resource.data.ownerId  == request.auth.uid
           || resource.data.farmerId == request.auth.uid)
          && resource.data.status != 'completed'
          && resource.data.paymentStatus != 'paid');
    }

    match /machines/{id} {
      allow read:          if isSignedIn();
      allow create:        if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update,delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /commissionPayments/{id} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.paymentStatus == 'pending_verification'
        && !('adminVerified' in request.resource.data);
      allow update: if isAdmin()
        || (isSignedIn()
          && resource.data.ownerId == request.auth.uid
          && !touchesAdminFields());
      allow delete: if isAdmin();
    }

    match /ratings/{id} {
      allow read:          if isSignedIn();
      allow create:        if isSignedIn()
        && request.resource.data.farmerId == request.auth.uid;
      allow update,delete: if isAdmin();
    }

    match /otpSessions/{id}            { allow read, write: if isSignedIn(); }
    match /appConfig/{id}              { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /appAccount/{id}             { allow read: if isAdmin(); allow create: if isSignedIn(); allow update,delete: if isAdmin(); }
    match /appAccountSummary/{id}      { allow read: if isAdmin(); allow write: if isSignedIn(); }
    match /dailyPayments/{id}          { allow read, write: if isSignedIn(); }
    match /pendingVerifications/{id}   { allow read, write: if isSignedIn(); }
    match /upiTransactions/{id}        { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /{document=**}               { allow read, write: if false; }
  }
}
