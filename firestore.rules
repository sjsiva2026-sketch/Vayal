rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────

    // Any authenticated user (phone or email/password)
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Admin = email/password sign-in + role field is "admin" in their user doc
    // No hardcoded UIDs — works for any admin account you create in Firebase Console
    function isAdmin() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'password'
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Fields only admin may write — prevent self-elevation
    function touchesAdminFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'paymentStatus', 'isLocked', 'kycStatus',
        'isVerified', 'accessGranted', 'adminVerified',
        'isBlocked', 'role'
      ]);
    }

    // ── USERS ─────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && isSignedIn()
                    && request.resource.data.role != 'admin';
      allow update: if isAdmin()
                    || (isSelf(uid) && isSignedIn() && !touchesAdminFields());
      allow delete: if isAdmin();
    }

    // ── BOOKINGS ──────────────────────────────────────────────────────────
    match /bookings/{id} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.farmerId == request.auth.uid;
      allow update: if isAdmin()
                    || (isSignedIn()
                        && (resource.data.ownerId  == request.auth.uid
                         || resource.data.farmerId == request.auth.uid)
                        && !touchesAdminFields());
      allow delete: if isAdmin()
                    || (isSignedIn()
                        && (resource.data.ownerId  == request.auth.uid
                         || resource.data.farmerId == request.auth.uid)
                        && resource.data.status        != 'completed'
                        && resource.data.paymentStatus != 'paid');
    }

    // ── MACHINES ──────────────────────────────────────────────────────────
    match /machines/{id} {
      allow read:           if isSignedIn();
      allow create:         if isSignedIn()
                            && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin()
                            || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // ── COMMISSION PAYMENTS ───────────────────────────────────────────────
    match /commissionPayments/{id} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.ownerId       == request.auth.uid
                    && request.resource.data.paymentStatus == 'pending_verification'
                    && !('adminVerified' in request.resource.data);
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.ownerId == request.auth.uid
                        && !touchesAdminFields());
      allow delete: if isAdmin();
    }

    // ── RATINGS ───────────────────────────────────────────────────────────
    match /ratings/{id} {
      allow read:           if isSignedIn();
      allow create:         if isSignedIn()
                            && request.resource.data.farmerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── APP CONFIG (maintenance flag, app settings) ───────────────────────
    match /appConfig/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── APP ACCOUNT ───────────────────────────────────────────────────────
    match /appAccount/{id} {
      allow read:           if isAdmin();
      allow create:         if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /appAccountSummary/{id} {
      allow read:  if isAdmin();
      allow write: if isSignedIn();
    }

    // ── DAILY PAYMENTS ────────────────────────────────────────────────────
    match /dailyPayments/{id} {
      allow read, write: if isSignedIn();
    }

    // ── PENDING VERIFICATIONS ─────────────────────────────────────────────
    match /pendingVerifications/{id} {
      allow read:           if isAdmin();
      allow create, update: if isSignedIn();
      allow delete:         if isAdmin();
    }

    // ── DENY EVERYTHING ELSE ──────────────────────────────────────────────
    // This replaces the insecure catch-all that allowed any auth user
    // to read/write ANY document not covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
