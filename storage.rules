rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ════════════════════════════════════════════════════════════════
    //  HELPER FUNCTIONS
    // ════════════════════════════════════════════════════════════════

    function isAuth() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── ADMIN CHECK ──────────────────────────────────────────────────
    // Storage rules-ல Firestore get() call முடியாது.
    // எனவே sign_in_provider + exact email address check.
    //
    // உங்க admin email கீழ மாத்துங்க:
    function isAdmin() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'password'
          && request.auth.token.email == 'sjsiva2026@gmail.com';
    }

    // Max 5 MB, image MIME type மட்டும்
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // ════════════════════════════════════════════════════════════════
    //  KYC DOCUMENTS  kyc/{ownerId}/{filename}
    //  Owner upload, Owner + Admin read, Admin delete
    // ════════════════════════════════════════════════════════════════
    match /kyc/{ownerId}/{filename} {
      allow write:  if isSelf(ownerId) && isValidImage();
      allow read:   if isSelf(ownerId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    //  PAYMENT SCREENSHOTS  payments/{ownerId}/{filename}
    //  Owner upload, Owner + Admin read, Admin delete
    // ════════════════════════════════════════════════════════════════
    match /payments/{ownerId}/{filename} {
      allow write:  if isSelf(ownerId) && isValidImage();
      allow read:   if isSelf(ownerId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    //  PROFILE PHOTOS  profiles/{userId}/{filename}
    //  Self upload, All logged-in users read, Self + Admin delete
    // ════════════════════════════════════════════════════════════════
    match /profiles/{userId}/{filename} {
      allow write:  if isSelf(userId) && isValidImage();
      allow read:   if isAuth();
      allow delete: if isSelf(userId) || isAdmin();
    }

    // ════════════════════════════════════════════════════════════════
    //  LEGACY PROFILE PHOTOS  profilePhotos/{filename}
    //  Backwards compatibility
    // ════════════════════════════════════════════════════════════════
    match /profilePhotos/{filename} {
      allow read:  if isAuth();
      allow write: if isAuth() && isValidImage();
    }

    // ════════════════════════════════════════════════════════════════
    //  DENY EVERYTHING ELSE
    // ════════════════════════════════════════════════════════════════
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
